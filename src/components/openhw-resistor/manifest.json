{
    "type": "openhw-resistor",
    "label": "Resistor",
    "description": "Passive two-terminal component that limits current flow. Configurable resistance (\u03a9). Essential for current-limiting LEDs and voltage dividers.",
    "group": "Basic",
    "w": 60,
    "h": 15,
    "attrs": {
        "value": "220",
        "breadboard": {
            "anchorPin": "p1"
        }
    },
    "telemetry": {
        "template": "resistance=${attr.value} Ohms",
        "criticalKeys": [
            "attr.value"
        ]
    },
    "pins": [
        {
            "id": "p1",
            "x": 0,
            "y": 7.5,
            "type": "passive",
            "description": "Terminal 1"
        },
        {
            "id": "p2",
            "x": 60,
            "y": 7.5,
            "type": "passive",
            "description": "Terminal 2"
        }
    ],
    "sab": {
        "slotKind": 0,
        "fields": {
            "f0": "voltageDrop",
            "f1": "current",
            "i0": "glow"
        }
    },
    "ui": {
        "svg": "./resistor.svg",
        "interactive": []
    },
    "sim": {
        "runtime": "js",
        "validation": "inline"
    },
    "bounds": {"x": 0, "y": 0, "w": 60, "h": 15}
}
