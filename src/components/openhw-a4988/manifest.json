{
    "type": "openhw-a4988",
    "label": "A4988 Stepper Driver",
    "group": "Actuators",
    "w": 120,
    "h": 75,
    "attrs": {},
    "pins": [
        { "id": "ENABLE",    "x": 112.5, "y": 7.5,  "type": "digital" },
        { "id": "MS1",       "x": 97.5,  "y": 7.5,  "type": "digital" },
        { "id": "MS2",       "x": 82.5,  "y": 7.5,  "type": "digital" },
        { "id": "MS3",       "x": 67.5,  "y": 7.5,  "type": "digital" },
        { "id": "RESET",     "x": 52.5,  "y": 7.5,  "type": "digital" },
        { "id": "SLEEP",     "x": 37.5,  "y": 7.5,  "type": "digital" },
        { "id": "STEP",      "x": 22.5,  "y": 7.5,  "type": "digital" },
        { "id": "DIR",       "x": 7.5,   "y": 7.5,  "type": "digital" },
        { "id": "VMOT",      "x": 112.5, "y": 67.5, "type": "power" },
        { "id": "GND_MOT",   "x": 97.5,  "y": 67.5, "type": "power" },
        { "id": "2B",        "x": 82.5,  "y": 67.5, "type": "digital" },
        { "id": "2A",        "x": 67.5,  "y": 67.5, "type": "digital" },
        { "id": "1A",        "x": 52.5,  "y": 67.5, "type": "digital" },
        { "id": "1B",        "x": 37.5,  "y": 67.5, "type": "digital" },
        { "id": "VDD",       "x": 22.5,  "y": 67.5, "type": "power" },
        { "id": "GND_LOGIC", "x": 7.5,   "y": 67.5, "type": "power" }
    ],
    "autowiring": {
        "connections": [
            { "from": "STEP",      "to": "arduino:8" },
            { "from": "DIR",       "to": "arduino:9" },
            { "from": "ENABLE",    "to": "arduino:10" },
            { "from": "VDD",       "to": "arduino:3V3" },
            { "from": "GND_LOGIC", "to": "arduino:GND" },
            { "from": "VMOT",      "to": "powersupply:5V" },
            { "from": "GND_MOT",   "to": "powersupply:GND" },
            { "from": "RESET",     "to": "arduino:3V3" },
            { "from": "SLEEP",     "to": "arduino:3V3" }
        ],
        "externalPower": true,
        "externalVoltage": "12.0"
    },
    "autocoding": {
        "arduino": {
            "setup": "pinMode(${STEP}, OUTPUT);\npinMode(${DIR}, OUTPUT);\npinMode(${ENABLE}, OUTPUT);\ndigitalWrite(${ENABLE}, LOW);\nSerial.begin(9600);\nSerial.println(\"A4988 Stepper Driver Ready\");",
            "loop": "digitalWrite(${DIR}, HIGH);\nSerial.println(\"Moving CW\");\nfor (int i_${COMP_SUFFIX} = 0; i_${COMP_SUFFIX} < 200; i_${COMP_SUFFIX}++) {\n  digitalWrite(${STEP}, HIGH);\n  delayMicroseconds(1000);\n  digitalWrite(${STEP}, LOW);\n  delayMicroseconds(1000);\n}\ndelay(500);\ndigitalWrite(${DIR}, LOW);\nSerial.println(\"Moving CCW\");\nfor (int i_${COMP_SUFFIX} = 0; i_${COMP_SUFFIX} < 200; i_${COMP_SUFFIX}++) {\n  digitalWrite(${STEP}, HIGH);\n  delayMicroseconds(1000);\n  digitalWrite(${STEP}, LOW);\n  delayMicroseconds(1000);\n}\ndelay(500);"
        }
    }
}
