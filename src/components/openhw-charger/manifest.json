{
    "type": "openhw-charger",
    "name": "TP4056 Charger",
    "label": "Li-ion Charger",
    "description": "TP4056 based Lithium-ion charging module. Detects USB power and manages battery charging.",
    "group": "Power",
    "w": 80,
    "h": 50,
    "pins": [
        { "id": "IN+", "label": "USB+", "x": 0, "y": 10 },
        { "id": "IN-", "label": "USB-", "x": 0, "y": 30 },
        { "id": "BAT+", "label": "BAT+", "x": 60, "y": 10 },
        { "id": "BAT-", "label": "BAT-", "x": 60, "y": 30 }
    ],
    "attrs": {
        "chargeCurrentMa": "1000"
    },
    "sab": {
        "slotKind": 0,
        "fields": {"f0": "currentMa", "i0": "isCharging"}
    },
    "ui": {"svg": "./charger.svg", "interactive": []},
    "sim": {"runtime": "js", "validation": "inline"},
    "bounds": {"x": 0, "y": 0, "w": 80, "h": 50}
}
