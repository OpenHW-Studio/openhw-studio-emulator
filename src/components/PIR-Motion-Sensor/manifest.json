{
    "type": "wokwi-pir-motion-sensor",
    "label": "PIR Motion Sensor",
    "description": "Passive Infrared (PIR) motion detection sensor. Outputs HIGH on the OUT pin when motion is detected.",
    "group": "Sensors",
    "w": 170.7,
    "h": 170.7,
    "attrs": {
        "delay": 500
    },
    "pins": [
        {
            "id": "VCC",
            "type": "power",
            "description": "Power (5V)",
            "x": 68.5,
            "y": 175.8
        },
        {
            "id": "GND",
            "type": "power",
            "description": "Ground",
            "x": 98.5,
            "y": 175.8
        },
        {
            "id": "OUT",
            "type": "digital",
            "description": "Digital Output",
            "x": 83.5,
            "y": 175.8
        }
    ],
    "autocoding": {
        "arduino": {
            "setup": "#define PIR_PIN ${OUT}\npinMode(PIR_PIN, INPUT);\nSerial.println(\"PIR Motion Sensor ready.\");",
            "loop": "int motionState = digitalRead(PIR_PIN);\nif (motionState == HIGH) {\n  Serial.println(\"Motion detected!\");\n} else {\n  Serial.println(\"No motion.\");\n}\ndelay(500);"
        }
    },
    "autowiring": {
        "connections": [
            {
                "from": "VCC",
                "to": "arduino:5V"
            },
            {
                "from": "GND",
                "to": "arduino:GND"
            },
            {
                "from": "OUT",
                "to": "arduino:13"
            }
        ]
    } 
}
