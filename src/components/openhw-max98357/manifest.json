{
  "type": "openhw-max98357",
  "label": "MAX98357 I2S Amp",
  "group": "Audio",
  "description": "I2S 3W Class D Amplifier",
  "w": 75,
  "h": 105,
  "tags": ["audio", "i2s", "amplifier", "amp", "max98357"],
  "pins": [
    { "id": "LRC", "description": "Left/Right Clock", "x": 7.5, "y": 7.5 },
    { "id": "BCLK", "description": "Bit Clock", "x": 7.5, "y": 22.5 },
    { "id": "DIN", "description": "Data In", "x": 7.5, "y": 37.5 },
    { "id": "GAIN", "description": "Gain Select", "x": 7.5, "y": 52.5 },
    { "id": "SD", "description": "Shutdown / Channel Select", "x": 7.5, "y": 67.5 },
    { "id": "GND", "description": "Ground", "x": 7.5, "y": 82.5 },
    { "id": "VIN", "description": "Power (2.5V-5.5V)", "x": 7.5, "y": 97.5 },
    { "id": "OUT+", "description": "Positive Speaker Output", "x": 67.5, "y": 37.5 },
    { "id": "OUT-", "description": "Negative Speaker Output", "x": 67.5, "y": 67.5 }
  ],
  "state": {
    "i2sBitsPerFrame": 16,
    "lastLeftSample": 0,
    "lastRightSample": 0,
    "peakAmplitude": 0,
    "i2sAudioChunk": null
  },
  "defaultAttrs": {},
  "telemetry": {
    "template": "BitsPerFrame=${state.i2sBitsPerFrame}",
    "criticalKeys": [
      "state.i2sBitsPerFrame"
    ]
  },
  "autowiring": {
    "connections": [
      {
        "from": "VIN",
        "to": "arduino:5V",
        "color": "red"
      },
      {
        "from": "GND",
        "to": "arduino:GND",
        "color": "black"
      },
      {
        "from": "LRC",
        "to": "arduino:25",
        "color": "yellow"
      },
      {
        "from": "BCLK",
        "to": "arduino:26",
        "color": "green"
      },
      {
        "from": "DIN",
        "to": "arduino:22",
        "color": "blue"
      }
    ]
  },
  "autocoding": {
    "libraries": [
      "I2S",
      "SD"
    ],
    "arduino": {
    "globals": "#include <I2S.h>\n#include <SD.h>\nFile audioFile;\n",
      "setup": "Serial.begin(9600);\nI2S.setBCLK(${BCLK});\nI2S.setDATA(${DIN});\nI2S.begin(I2S_PHILIPS_MODE, 44100, 16);\nSD.begin(5);\naudioFile = SD.open(\"/rec.wav\");",
      "loop": "if (audioFile && audioFile.available()) {\n  int16_t sample = 0;\n  audioFile.read((uint8_t*)&sample, 2);\n  I2S.write(sample);\n  I2S.write(sample);\n}"
    }
  }
}
