{
  "type": "openhw-max98357",
  "name": "I2S Amplifier (MAX98357A)",
  "author": "Velxio",
  "version": "1.0.0",
  "group": "Audio",
  "description": "I2S Audio Amplifier (Class D) Decoder",
  "tags": ["audio", "i2s", "amplifier", "sound", "max98357"],
  "pins": [
    { "id": "VIN", "name": "VIN", "description": "Power (2.5V to 5.5V)", "x": 10, "y": 60 },
    { "id": "GND", "name": "GND", "description": "Ground", "x": 18, "y": 60 },
    { "id": "SD", "name": "SD", "description": "Shutdown and Channel Select", "x": 26, "y": 60 },
    { "id": "GAIN", "name": "GAIN", "description": "Gain select", "x": 34, "y": 60 },
    { "id": "DIN", "name": "DIN", "description": "I2S Serial Data", "x": 42, "y": 60 },
    { "id": "BCLK", "name": "BCLK", "description": "I2S Bit Clock", "x": 50, "y": 60 },
    { "id": "LRC", "name": "LRC", "description": "I2S Word Select", "x": 58, "y": 60 },
    { "id": "OUT+", "name": "OUT+", "description": "Positive Speaker Output", "x": 66, "y": 60 },
    { "id": "OUT-", "name": "OUT-", "description": "Negative Speaker Output", "x": 74, "y": 60 }
  ],
  "state": {
    "i2sBitsPerFrame": 16,
    "lastLeftSample": 0,
    "lastRightSample": 0,
    "peakAmplitude": 0,
    "i2sAudioChunk": null
  },
  "defaultAttrs": {},
  "autowire": {
    "groups": {
      "i2s": [
        { "pin": "VIN", "function": "vcc" },
        { "pin": "GND", "function": "gnd" },
        { "pin": "BCLK", "function": "sck" },
        { "pin": "DIN", "function": "mosi" },
        { "pin": "LRC", "function": "cs" }
      ]
    }
  }
}
