{
  "type": "openhw-bmp180-breakout",
  "label": "BMP180 Pressure Sensor Breakout",
  "group": "Sensors",
  "description": "A breakout board for the Bosch BMP180 digital pressure and temperature sensor.",
  "w": 72,
  "h": 50,
  "attrs": {
    "i2cAddress": "0x77",
    "pressure": "1013.25",
    "temperature": "25.0"
  },
  "pins": [
    {
      "id": "VIN",
      "x": 10,
      "y": 48,
      "type": "power",
      "description": "Voltage Input (3.3V - 5V typical due to onboard regulator)"
    },
    {
      "id": "GND",
      "x": 25,
      "y": 48,
      "type": "power",
      "description": "Ground"
    },
    {
      "id": "SCL",
      "x": 40,
      "y": 48,
      "type": "input",
      "description": "I2C Serial Clock"
    },
    {
      "id": "SDA",
      "x": 55,
      "y": 48,
      "type": "bidirectional",
      "description": "I2C Serial Data"
    }
  ],
  "telemetry": {
    "template": "Temp=${state.temp}°C, Pres=${state.pressure}Pa",
    "criticalKeys": ["state.temp", "state.pressure"]
  },
  "autowiring": {
    "connections": [
      { "from": "GND", "to": "arduino:GND" },
      { "from": "VIN", "to": "arduino:3V3" },
      { "from": "SDA", "to": "arduino:A4", "i2c": true },
      { "from": "SCL", "to": "arduino:A5", "i2c": true }
    ]
  },
  "autocoding": {
    "libraries": ["Adafruit BMP085 Library"],
    "arduino": {
      "globals": "#include <Wire.h>\n#include <Adafruit_BMP085.h>\nAdafruit_BMP085 bmp_${COMP_SUFFIX};",
      "setup": "if (!bmp_${COMP_SUFFIX}.begin()) {\n  Serial.println(\"Could not find a valid BMP085 sensor, check wiring!\");\n  while (1) {}\n}",
      "loop": "Serial.print(\"Temperature = \");\nSerial.print(bmp_${COMP_SUFFIX}.readTemperature());\nSerial.println(\" *C\");\ndelay(1000);"
    }
  }
}
