{
    "type": "openhw-lcd1602-i2c",
    "label": "LCD 16x2 (I2C)",
    "description": "16x2 Character LCD Display with I2C Backpack",
    "group": "Displays",
    "w": 315,
    "h": 135,
    "attrs": {
        "i2cAddress": "0x27",
        "color": "blue",
        "breadboard": {
            "anchorPin": "GND"
        }
    },
    "pins": [
        {
            "id": "GND",
            "x": 7.5,
            "y": 37.5,
            "type": "power",
            "description": "Ground"
        },
        {
            "id": "VCC",
            "x": 7.5,
            "y": 52.5,
            "type": "power",
            "description": "Power (5V)"
        },
        {
            "id": "SDA",
            "x": 7.5,
            "y": 67.5,
            "type": "bidi",
            "description": "I2C Data"
        },
        {
            "id": "SCL",
            "x": 7.5,
            "y": 82.5,
            "type": "bidi",
            "description": "I2C Clock"
        }
    ],
    "autocoding": {
        "libraries": ["LiquidCrystal I2C"],
        "arduino": {
            "globals": "#include <Wire.h>\n#include <LiquidCrystal_I2C.h>\n\nLiquidCrystal_I2C lcd_${COMP_SUFFIX}(0x27, 16, 2);",
            "setup": "lcd_${COMP_SUFFIX}.init();\nlcd_${COMP_SUFFIX}.backlight();\nlcd_${COMP_SUFFIX}.setCursor(0, 0);\nlcd_${COMP_SUFFIX}.print(\"OpenHW Studio!\");",
            "loop": "unsigned long t_${COMP_SUFFIX} = millis() / 1000;\nlcd_${COMP_SUFFIX}.setCursor(0, 1);\nlcd_${COMP_SUFFIX}.print(\"Timer: \");\nlcd_${COMP_SUFFIX}.print(t_${COMP_SUFFIX});\nlcd_${COMP_SUFFIX}.print(\" s   \");\ndelay(500);"
        }
    }
}
