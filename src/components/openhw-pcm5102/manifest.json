{
  "type": "openhw-pcm5102",
  "label": "PCM5102 I2S DAC",
  "group": "Audio",
  "description": "32-bit I2S Stereo DAC",
  "w": 90,
  "h": 60,
  "tags": ["audio", "i2s", "dac", "pcm5102"],
  "pins": [
    { "id": "VCC", "description": "Power (3.3V-5V)", "x": 7.5, "y": 7.5 },
    { "id": "GND", "description": "Ground", "x": 22.5, "y": 7.5 },
    { "id": "FLT", "description": "Filter Select", "x": 37.5, "y": 7.5 },
    { "id": "DMP", "description": "De-emphasis", "x": 52.5, "y": 7.5 },
    { "id": "XMT", "description": "Mute", "x": 67.5, "y": 7.5 },
    { "id": "FMT", "description": "Format Select", "x": 82.5, "y": 7.5 },
    { "id": "SCK", "description": "System Clock", "x": 7.5, "y": 52.5 },
    { "id": "BCK", "description": "Bit Clock", "x": 22.5, "y": 52.5 },
    { "id": "DIN", "description": "Data In", "x": 37.5, "y": 52.5 },
    { "id": "LCK", "description": "Left/Right Clock", "x": 52.5, "y": 52.5 },
    { "id": "OUTL", "description": "Left Audio Out", "x": 67.5, "y": 52.5 },
    { "id": "OUTR", "description": "Right Audio Out", "x": 82.5, "y": 52.5 }
  ],
  "state": {
    "i2sBitsPerFrame": 16,
    "lastLeftSample": 0,
    "lastRightSample": 0,
    "peakAmplitude": 0,
    "i2sAudioChunk": null
  },
  "defaultAttrs": {},
  "telemetry": {
    "template": "BitsPerFrame=${state.i2sBitsPerFrame}",
    "criticalKeys": ["state.i2sBitsPerFrame"]
  },
  "autowiring": {
    "connections": [
      { "from": "VCC", "to": "arduino:5V", "color": "red" },
      { "from": "GND", "to": "arduino:GND", "color": "black" },
      { "from": "LCK", "to": "arduino:25", "color": "yellow" },
      { "from": "BCK", "to": "arduino:26", "color": "green" },
      { "from": "DIN", "to": "arduino:22", "color": "blue" }
    ]
  },
  "autocoding": {
    "libraries": ["I2S", "SD"],
    "arduino": {
      "globals": "#include <I2S.h>\\n#include <SD.h>\\nFile audioFile;\\n",
      "setup": "Serial.begin(9600);\\nI2S.setBCLK(${BCK});\\nI2S.setDATA(${DIN});\\nI2S.begin(I2S_PHILIPS_MODE, 44100, 16);\\nSD.begin(5);\\naudioFile = SD.open(\\\"/rec.wav\\\");",
      "loop": "if (audioFile && audioFile.available()) {\\n  int16_t sample = 0;\\n  audioFile.read((uint8_t*)&sample, 2);\\n  I2S.write(sample);\\n  I2S.write(sample);\\n}"
    }
  }
}
