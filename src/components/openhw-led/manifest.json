{
    "type": "openhw-led",
    "label": "LED",
    "description": "Light-emitting diode. Emits light when current flows through it. Supports multiple colors via the color attribute.",
    "group": "Outputs",
    "w": 38,
    "h": 38,
    "attrs": {
        "color": "red",
        "breadboard": {
            "anchorPin": "A"
        }
    },
    "telemetry": {
        "template": "illuminated=${state.illuminated}, brightness=${state.brightness}, burnedOut=${state.burnedOut}",
        "criticalKeys": [
            "state.illuminated",
            "state.brightness",
            "state.burnedOut"
        ]
    },
    "pins": [
        {
            "id": "A",
            "x": 10,
            "y": 40,
            "type": "input",
            "description": "Anode (+)"
        },
        {
            "id": "K",
            "x": 25,
            "y": 40,
            "type": "input",
            "description": "Cathode (-)"
        }
    ],
    "autocoding": {
        "arduino": {
            "setup": "pinMode(${A}, OUTPUT);",
            "loop": "digitalWrite(${A}, HIGH);\ndelay(1000);\ndigitalWrite(${A}, LOW);\ndelay(1000);"
        },
        "micropython": {
            "setup": "from machine import Pin\nimport time\nled = Pin(${A}, Pin.OUT)",
            "loop": "led.value(1)\ntime.sleep(1)\nled.value(0)\ntime.sleep(1)"
        }
    },
    "autowiring": {
        "connections": [
            { "from": "A", "to": "arduino:13", "via": "openhw-resistor", "attrs": { "value": "220" } },
            { "from": "K", "to": "arduino:GND" }
        ]
    }
}
