{
    "type": "openhw-raindrop-module",
    "label": "Raindrop Module",
    "description": "LM393-based raindrop comparator module. Reads from sensing pad and outputs AO (analog) and DO (digital, active LOW) for Arduino/ESP32.",
    "group": "Sensors",
    "w": 70,
    "h": 160,
    "width": 40,
    "height": 160,
    "attrs": {
        "threshold": 512
    },
    "pins": [
        { "id": "VCC",  "label": "VCC",  "type": "power",   "x": 49,   "y": 155 },
        { "id": "GND",  "label": "GND",  "type": "power",   "x": 39,   "y": 155 },
        { "id": "DO",   "label": "DO",   "type": "digital", "x": 30,   "y": 155 },
        { "id": "AO",   "label": "AO",   "type": "analog",  "x": 21,   "y": 155 },
        { "id": "PAD+", "label": "PAD+", "type": "analog",  "x": 33,   "y": 5   },
        { "id": "PAD-", "label": "PAD-", "type": "power",   "x": 42.5, "y": 5   }
    ],
    "autocoding": {
        "arduino": {
            "globals": "#define RAIN_AO_PIN_${COMP_SUFFIX} ${AO}\n#define RAIN_DO_PIN_${COMP_SUFFIX} ${DO}",
            "setup": "pinMode(RAIN_DO_PIN_${COMP_SUFFIX}, INPUT);\nSerial.println(\"Raindrop Module ${COMP_SUFFIX} ready.\");",
            "loop": "int rainLevel_${COMP_SUFFIX} = analogRead(RAIN_AO_PIN_${COMP_SUFFIX});\nint doVal_${COMP_SUFFIX} = digitalRead(RAIN_DO_PIN_${COMP_SUFFIX});\nSerial.print(\"Rain Module ${COMP_SUFFIX} Level: \");\nSerial.print(rainLevel_${COMP_SUFFIX});\nSerial.print(\"  DO: \");\nSerial.println(doVal_${COMP_SUFFIX} == LOW ? \"RAIN DETECTED\" : \"Dry\");\ndelay(1000);"
        }
    },
    "autowiring": {
        "helpers": [
            { "type": "openhw-raindrop-pad", "id": "pad" }
        ],
        "connections": [
            { "from": "VCC", "to": "arduino:5V", "color": "red" },
            { "from": "GND", "to": "arduino:GND", "color": "black" },
            { "from": "DO",  "to": "arduino:2", "color": "green" },
            { "from": "AO",  "to": "arduino:A0", "color": "yellow" },
            { "from": "PAD+", "to": "helper:pad:AOUT", "color": "blue" },
            { "from": "PAD-", "to": "helper:pad:GND", "color": "black" }
        ]
    }
}