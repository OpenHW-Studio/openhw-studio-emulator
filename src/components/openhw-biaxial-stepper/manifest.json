{
    "type": "openhw-biaxial-stepper",
    "label": "Biaxial Stepper Motor",
    "group": "Outputs",
    "w": 280,
    "h": 280,
    "attrs": {
        "outerHandLength": "30",
        "outerHandColor": "gold",
        "outerHandShape": "plain",
        "innerHandLength": "30",
        "innerHandColor": "silver",
        "innerHandShape": "plain",
        "step_angle": "1.8"
    },
    "pins": [
        {
            "id": "A1-",
            "x": 80,
            "y": 119,
            "type": "digital"
        },
        {
            "id": "A1+",
            "x": 80,
            "y": 129,
            "type": "digital"
        },
        {
            "id": "B1+",
            "x": 80,
            "y": 139,
            "type": "digital"
        },
        {
            "id": "B1-",
            "x": 80,
            "y": 148,
            "type": "digital"
        },
        {
            "id": "A2-",
            "x": 80,
            "y": 158,
            "type": "digital"
        },
        {
            "id": "A2+",
            "x": 80,
            "y": 167,
            "type": "digital"
        },
        {
            "id": "B2+",
            "x": 80,
            "y": 177,
            "type": "digital"
        },
        {
            "id": "B2-",
            "x": 80,
            "y": 187,
            "type": "digital"
        }
    ],
    "autowiring": {
        "helpers": [
            {
                "type": "openhw-a4988",
                "id": "driverOuter"
            },
            {
                "type": "openhw-a4988",
                "id": "driverInner"
            },
            {
                "type": "openhw-power-supply",
                "id": "psu",
                "attrs": {
                    "voltage": "12.0"
                }
            }
        ],
        "connections": [
            {
                "from": "A1+",
                "to": "helper:driverOuter:1A"
            },
            {
                "from": "A1-",
                "to": "helper:driverOuter:2A"
            },
            {
                "from": "B1+",
                "to": "helper:driverOuter:1B"
            },
            {
                "from": "B1-",
                "to": "helper:driverOuter:2B"
            },
            {
                "from": "A2+",
                "to": "helper:driverInner:1A"
            },
            {
                "from": "A2-",
                "to": "helper:driverInner:2A"
            },
            {
                "from": "B2+",
                "to": "helper:driverInner:1B"
            },
            {
                "from": "B2-",
                "to": "helper:driverInner:2B"
            },
            {
                "from": "helper:driverOuter:STEP",
                "to": "arduino:8"
            },
            {
                "from": "helper:driverOuter:DIR",
                "to": "arduino:9"
            },
            {
                "from": "helper:driverOuter:ENABLE",
                "to": "arduino:10"
            },
            {
                "from": "helper:driverOuter:VDD",
                "to": "arduino:5V"
            },
            {
                "from": "helper:driverOuter:GND_LOGIC",
                "to": "arduino:GND"
            },
            {
                "from": "helper:driverOuter:VMOT",
                "to": "helper:psu:5V"
            },
            {
                "from": "helper:driverOuter:GND_MOT",
                "to": "helper:psu:GND"
            },
            {
                "from": "helper:driverOuter:RESET",
                "to": "helper:driverOuter:SLEEP"
            },
            {
                "from": "helper:driverInner:STEP",
                "to": "arduino:11"
            },
            {
                "from": "helper:driverInner:DIR",
                "to": "arduino:12"
            },
            {
                "from": "helper:driverInner:ENABLE",
                "to": "arduino:13"
            },
            {
                "from": "helper:driverInner:VDD",
                "to": "arduino:5V"
            },
            {
                "from": "helper:driverInner:GND_LOGIC",
                "to": "arduino:GND"
            },
            {
                "from": "helper:driverInner:VMOT",
                "to": "helper:psu:5V"
            },
            {
                "from": "helper:driverInner:GND_MOT",
                "to": "helper:psu:GND"
            },
            {
                "from": "helper:driverInner:RESET",
                "to": "helper:driverInner:SLEEP"
            }
        ]
    },
    "autocoding": {
        "libraries": [
            "AccelStepper"
        ],
        "arduino": {
            "setup": "// Outer motor on Step=8, Dir=9\n// Inner motor on Step=11, Dir=12\n#include <AccelStepper.h>\nAccelStepper stepperOuter(AccelStepper::DRIVER, 8, 9);\nAccelStepper stepperInner(AccelStepper::DRIVER, 11, 12);\n\nvoid setup() {\n  stepperOuter.setMaxSpeed(1000);\n  stepperOuter.setAcceleration(500);\n  stepperInner.setMaxSpeed(1000);\n  stepperInner.setAcceleration(500);\n}",
            "loop": "if (stepperOuter.distanceToGo() == 0) {\n  stepperOuter.moveTo(-stepperOuter.currentPosition() + 200);\n}\nif (stepperInner.distanceToGo() == 0) {\n  stepperInner.moveTo(-stepperInner.currentPosition() - 200);\n}\nstepperOuter.run();\nstepperInner.run();"
        }
    }
}