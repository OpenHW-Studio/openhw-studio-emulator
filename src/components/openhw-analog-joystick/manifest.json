{
    "type": "openhw-analog-joystick",
    "label": "Analog Joystick",
    "description": "2-axis analog joystick with push button",
    "group": "Sensors",
    "w": 237.4,
    "h": 277.5,
    "attrs": {},
    "pins": [
      {
        "id": "VCC",
        "x": 77.3,
        "y": 263.6,
        "type": "power",
        "description": "5V Power"
      },
      {
        "id": "VERT",
        "x": 92.3,
        "y": 263.6,
        "type": "analog",
        "description": "Y-axis output (Vertical)"
      },
      {
        "id": "HORZ",
        "x": 122.3,
        "y": 263.6,
        "type": "analog",
        "description": "X-axis output (Horizontal)"
      },
      {
        "id": "SEL",
        "x": 137.3,
        "y": 263.6,
        "type": "digital",
        "description": "Switch"
      },
      {
        "id": "GND",
        "x": 167.3,
        "y": 263.6,
        "type": "power",
        "description": "Ground"
      }
    ],
    "telemetry": {
      "template": "X=${state.x}, Y=${state.y}, Pressed=${state.pressed}",
      "criticalKeys": ["state.x", "state.y"]
    },
    "autowiring": {
      "connections": [
        { "from": "GND", "to": "arduino:GND" },
        { "from": "VCC", "to": "arduino:5V" },
        { "from": "VERT", "to": "arduino:A0" },
        { "from": "HORZ", "to": "arduino:A1" },
        { "from": "SEL", "to": "arduino:2" }
      ]
    },
    "autocoding": {
      "libraries": [],
      "arduino": {
        "globals": "const int xPin_${COMP_SUFFIX} = A0;\nconst int yPin_${COMP_SUFFIX} = A1;\nconst int swPin_${COMP_SUFFIX} = 2;",
        "setup": "pinMode(swPin_${COMP_SUFFIX}, INPUT_PULLUP);\nSerial.begin(9600);",
        "loop": "Serial.print(\"X: \"); Serial.print(analogRead(xPin_${COMP_SUFFIX}));\nSerial.print(\" Y: \"); Serial.print(analogRead(yPin_${COMP_SUFFIX}));\nSerial.print(\" SW: \"); Serial.println(digitalRead(swPin_${COMP_SUFFIX}));\ndelay(500);"
      }
    }
}
