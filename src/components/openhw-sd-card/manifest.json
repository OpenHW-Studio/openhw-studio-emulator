{
    "type": "openhw-sd-card",
    "label": "MicroSD Card",
    "description": "SPI microSD card module with virtual storage backed by an in-memory filesystem and optional littlefs-wasm runtime.",
    "group": "Memory",
    "w": 152,
    "h": 101.3,
    "attrs": {
        "mounted": "true",
        "capacityKB": "2048"
    },
    "telemetry": {
        "template": "mounted=${state.mounted}, fsReady=${state.fsReady}, fileCount=${state.fileCount}, usedBytes=${state.usedBytes}, lastOp=${state.lastOp}",
        "criticalKeys": [
            "state.mounted",
            "state.fsReady",
            "state.fileCount",
            "state.usedBytes",
            "state.lastOp"
        ]
    },
    "pins": [
        {
            "id": "VCC",
            "x": 14.5,
            "y": 101.3,
            "type": "power",
            "description": "Power"
        },
        {
            "id": "GND",
            "x": 29.8,
            "y": 101.3,
            "type": "power",
            "description": "Ground"
        },
        {
            "id": "CS",
            "x": 44.5,
            "y": 101.3,
            "type": "digital",
            "description": "Chip Select (active low)"
        },
        {
            "id": "SCK",
            "x": 88.9,
            "y": 101.3,
            "type": "digital",
            "description": "SPI Clock"
        },
        {
            "id": "MOSI",
            "x": 104.6,
            "y": 101.3,
            "type": "digital",
            "description": "Master Out / Slave In"
        },
        {
            "id": "MISO",
            "x": 120.3,
            "y": 101.3,
            "type": "digital",
            "description": "Master In / Slave Out"
        }
    ],
    "autowiring": {
        "connections": [
            { "from": "VCC", "to": "arduino:5V" },
            { "from": "GND", "to": "arduino:GND" },
            { "from": "SCK", "to": "arduino:SCK" },
            { "from": "MOSI", "to": "arduino:MOSI" },
            { "from": "MISO", "to": "arduino:MISO" },
            { "from": "CS", "to": "arduino:10" }
        ]
    },
    "autocoding": {
        "libraries": ["SD"],
        "arduino": {
            "globals": "#include <SPI.h>\n#include <SD.h>",
            "setup": "Serial.begin(9600);\nwhile (!Serial);\nSerial.print(\"Initializing SD card...\");\nif (!SD.begin(${CS})) {\n  Serial.println(\"initialization failed!\");\n  return;\n}\nSerial.println(\"initialization done.\");",
            "loop": "// SD Card ready for datalogging."
        }
    }
}
