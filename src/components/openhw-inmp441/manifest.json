{
  "type": "openhw-inmp441",
  "name": "I2S MEMS Microphone (INMP441)",
  "author": "Velxio",
  "version": "1.0.0",
  "group": "Audio",
  "description": "I2S Omnidirectional Microphone",
  "tags": ["audio", "i2s", "mic", "microphone", "inmp441"],
  "pins": [
    { "id": "VDD", "name": "VDD", "description": "Power (1.8V to 3.3V)", "x": 10, "y": 60 },
    { "id": "GND", "name": "GND", "description": "Ground", "x": 18, "y": 60 },
    { "id": "L/R", "name": "L/R", "description": "Left/Right Channel Select", "x": 26, "y": 60 },
    { "id": "WS", "name": "WS", "description": "Word Select / Left-Right Clock", "x": 34, "y": 60 },
    { "id": "SCK", "name": "SCK", "description": "Serial Data Clock", "x": 42, "y": 60 },
    { "id": "SD", "name": "SD", "description": "Serial Data Output", "x": 50, "y": 60 }
  ],
  "state": {
    "liveMicEnabled": true,
    "micBuffer": null,
    "bufferIndex": 0,
    "peakAmplitude": 0
  },
  "defaultAttrs": {},
  "autowire": {
    "groups": {
      "i2s": [
        { "pin": "VDD", "function": "vcc" },
        { "pin": "GND", "function": "gnd" },
        { "pin": "SCK", "function": "sck" },
        { "pin": "SD", "function": "miso" },
        { "pin": "WS", "function": "cs" }
      ]
    }
  }
}
