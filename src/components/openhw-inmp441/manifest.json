{
  "type": "openhw-inmp441",
  "label": "I2S MEMS Microphone (INMP441)",
  "group": "Audio",
  "description": "I2S Omnidirectional Microphone",
  "w": 60,
  "h": 70,
  "tags": ["audio", "i2s", "mic", "microphone", "inmp441"],
  "pins": [
    { "id": "VDD", "description": "Power (1.8V to 3.3V)", "x": 10, "y": 60 },
    { "id": "GND", "description": "Ground", "x": 18, "y": 60 },
    { "id": "L/R", "description": "Left/Right Channel Select", "x": 26, "y": 60 },
    { "id": "WS", "description": "Word Select / Left-Right Clock", "x": 34, "y": 60 },
    { "id": "SCK", "description": "Serial Data Clock", "x": 42, "y": 60 },
    { "id": "SD", "description": "Serial Data Output", "x": 50, "y": 60 }
  ],
  "state": {
    "liveMicEnabled": true,
    "micBuffer": null,
    "bufferIndex": 0,
    "peakAmplitude": 0
  },
  "defaultAttrs": {},
  "telemetry": {
    "template": "Live=${state.liveMicEnabled}, Peak=${state.peakAmplitude}",
    "criticalKeys": ["state.liveMicEnabled", "state.peakAmplitude"]
  },
  "autowiring": {
    "connections": [
      { "from": "VDD", "to": "arduino:3V3", "color": "red" },
      { "from": "GND", "to": "arduino:GND", "color": "black" },
      { "from": "L/R", "to": "arduino:GND", "color": "black" },
      { "from": "WS", "to": "arduino:25", "color": "yellow" },
      { "from": "SCK", "to": "arduino:26", "color": "green" },
      { "from": "SD", "to": "arduino:22", "color": "blue" }
    ]
  },
  "autocoding": {
    "libraries": ["I2S", "SD"],
    "arduino": {
      "globals": "#include <I2S.h>\\n#include <SD.h>\\nFile audioFile;\\n",
      "setup": "Serial.begin(9600);\\nI2S.setBCLK(${SCK});\\nI2S.setDATA(${SD});\\nI2S.begin(I2S_PHILIPS_MODE, 44100, 32);\\nSD.begin(5);\\naudioFile = SD.open(\\\"/rec.wav\\\", FILE_WRITE);",
      "loop": "int32_t sample = 0;\\nI2S.read();\\nsample = I2S.read();\\nif(audioFile) audioFile.write((uint8_t*)&sample, 4);"
    }
  }
}
