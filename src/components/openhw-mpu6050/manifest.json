{
    "type": "openhw-mpu6050",
    "label": "MPU6050 IMU Sensor",
    "group": "Sensors",
    "w": 135,
    "h": 105,
    "attrs": {
        "accelX": "0",
        "accelY": "0",
        "accelZ": "1",
        "gyroX": "0",
        "gyroY": "0",
        "gyroZ": "0",
        "temperature": "25"
    },
    "pins": [
        { "id": "INT", "x": 15,  "y": 15, "type": "output",        "description": "Interrupt output" },
        { "id": "AD0", "x": 30,  "y": 15, "type": "input",         "description": "I2C Slave Address LSB" },
        { "id": "XCL", "x": 45,  "y": 15, "type": "output",        "description": "Auxiliary I2C Clock" },
        { "id": "XDA", "x": 60,  "y": 15, "type": "bidirectional", "description": "Auxiliary I2C Data" },
        { "id": "SDA", "x": 75,  "y": 15, "type": "bidirectional", "description": "I2C Data" },
        { "id": "SCL", "x": 90,  "y": 15, "type": "input",         "description": "I2C Clock" },
        { "id": "GND", "x": 105, "y": 15, "type": "input",         "description": "Ground" },
        { "id": "VCC", "x": 120, "y": 15, "type": "input",         "description": "Power (3.3V or 5V)" }
    ],
    "telemetry": {
      "template": "A=(${state.ax},${state.ay},${state.az}) G=(${state.gx},${state.gy},${state.gz}) T=${state.temp}",
      "criticalKeys": ["state.ax", "state.gx", "state.temp"]
    },
    "autowiring": {
      "connections": [
        { "from": "GND", "to": "arduino:GND" },
        { "from": "VCC", "to": "arduino:5V" },
        { "from": "SDA", "to": "arduino:A4", "i2c": true },
        { "from": "SCL", "to": "arduino:A5", "i2c": true }
      ]
    },
    "autocoding": {
      "libraries": ["Adafruit MPU6050", "Adafruit Unified Sensor"],
      "arduino": {
        "globals": "#include <Wire.h>\n#include <Adafruit_MPU6050.h>\n#include <Adafruit_Sensor.h>\nAdafruit_MPU6050 mpu_${COMP_SUFFIX};",
        "setup": "if (!mpu_${COMP_SUFFIX}.begin()) {\n  Serial.println(\"Failed to find MPU6050 chip\");\n  while (1);\n}",
        "loop": "sensors_event_t a_${COMP_SUFFIX}, g_${COMP_SUFFIX}, temp_${COMP_SUFFIX};\nmpu_${COMP_SUFFIX}.getEvent(&a_${COMP_SUFFIX}, &g_${COMP_SUFFIX}, &temp_${COMP_SUFFIX});\nSerial.print(\"Accel X: \"); Serial.println(a_${COMP_SUFFIX}.acceleration.x);\ndelay(500);"
      }
    }
}
