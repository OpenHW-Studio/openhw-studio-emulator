  "autowiring": {
      "connections": [
          { "from": "VIN", "to": "arduino:3V3" },
          { "from": "GND", "to": "arduino:GND" },
          { "from": "SDA", "to": "arduino:SDA" },
          { "from": "SCL", "to": "arduino:SCL" }
      ]
  },
  "autocoding": {
      "libraries": ["MAX30105"],
      "arduino": {
          "globals": "#include <Wire.h>\n#include \"MAX30105.h\"\n\nMAX30105 particleSensor_${COMP_SUFFIX};",
          "setup": "Serial.begin(9600);\nif (!particleSensor_${COMP_SUFFIX}.begin(Wire, I2C_SPEED_FAST)) {\n  Serial.println(\"MAX30102 not found\");\n  while (1);\n}\nparticleSensor_${COMP_SUFFIX}.setup();",
          "loop": "Serial.print(\" R:\"); Serial.print(particleSensor_${COMP_SUFFIX}.getRed());\nSerial.print(\" IR:\"); Serial.print(particleSensor_${COMP_SUFFIX}.getIR());\nSerial.println();\ndelay(100);"
      }
  }
}
