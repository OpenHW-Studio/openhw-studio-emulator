        },
        "irLed": {
            "label": "IR LED (880nm)",
            "type": "number",
            "default": 0
        }
    },
    "pins": [
        {
            "id": "VIN",
            "x": 71.3,
            "y": 62.4,
            "type": "power"
        },
        {
            "id": "SDA",
            "x": 56.2,
            "y": 62.4,
            "type": "digital"
        },
        {
            "id": "SCL",
            "x": 41,
            "y": 62.4,
            "type": "digital"
        },
        {
            "id": "GND",
            "x": 26.6,
            "y": 62.4,
            "type": "power"
        },
        {
            "id": "INT",
            "x": 26.6,
            "y": 1.6,
            "type": "digital"
        },
        {
            "id": "IRD",
            "x": 41,
            "y": 1.6,
            "type": "digital"
        },
        {
            "id": "RD",
