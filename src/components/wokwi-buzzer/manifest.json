{
    "type": "wokwi-buzzer",
    "label": "Buzzer",
    "description": "Piezoelectric buzzer that generates audio tones when driven by PWM or toggled digital signals. Frequency determines pitch; use tone() in Arduino.",
    "group": "Outputs",
    "w": 36,
    "h": 47.6,
    "attrs": {},
    "pins": [
        {
            "id": "1",
            "x": 10.1,
            "y": 45.9,
            "type": "digital",
            "description": "Positive"
        },
        {
            "id": "2",
            "x": 25.1,
            "y": 45.9,
            "type": "power",
            "description": "Negative"
        }
    ],
    "autowiring": {
        "connections": [
            { "from": "1", "to": "arduino:8", "via": "wokwi-resistor", "attrs": { "value": "100" } },
            { "from": "2", "to": "arduino:GND" }
        ]
    },
    "autocoding": {
        "arduino": {
            "setup": "pinMode(${1}, OUTPUT);",
            "loop": "int notes[] = {262, 294, 330, 349, 392, 440, 494, 523};\nint durs[] = {200, 200, 200, 200, 200, 200, 200, 400};\nfor (int i = 0; i < 8; i++) {\n  tone(${1}, notes[i], durs[i]);\n  delay(durs[i] + 30);\n}\nnoTone(${1});\ndelay(1000);"
        }
    }
}