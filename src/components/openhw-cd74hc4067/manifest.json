      "arduino": {
        "globals": "const int s0_${COMP_SUFFIX} = 8;\nconst int s1_${COMP_SUFFIX} = 9;\nconst int s2_${COMP_SUFFIX} = 10;\nconst int s3_${COMP_SUFFIX} = 11;\nconst int sig_${COMP_SUFFIX} = A0;",
        "setup": "pinMode(s0_${COMP_SUFFIX}, OUTPUT);\npinMode(s1_${COMP_SUFFIX}, OUTPUT);\npinMode(s2_${COMP_SUFFIX}, OUTPUT);\npinMode(s3_${COMP_SUFFIX}, OUTPUT);",
        "loop": "for(int i = 0; i < 16; i++) {\n  digitalWrite(s0_${COMP_SUFFIX}, i & 0x01);\n  digitalWrite(s1_${COMP_SUFFIX}, (i >> 1) & 0x01);\n  digitalWrite(s2_${COMP_SUFFIX}, (i >> 2) & 0x01);\n  digitalWrite(s3_${COMP_SUFFIX}, (i >> 3) & 0x01);\n  int val = analogRead(sig_${COMP_SUFFIX});\n}\ndelay(1000);"
      }
