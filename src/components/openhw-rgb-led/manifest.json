{
    "type": "openhw-rgb-led",
    "label": "RGB LED (4-pin)",
    "group": "Outputs",
    "w": 64.2,
    "h": 64.2,
    "attrs": {
        "common": "cathode",
        "breadboard": {
            "anchorPin": "R"
        }
    },
    "pins": [
        {
            "id": "R",
            "x": 10.7,
            "y": 64.2,
            "type": "digital"
        },
        {
            "id": "COM",
            "x": 25.7,
            "y": 64.2,
            "type": "digital"
        },
        {
            "id": "G",
            "x": 40.7,
            "y": 64.2,
            "type": "digital"
        },
        {
            "id": "B",
            "x": 55.7,
            "y": 64.2,
            "type": "digital"
        }
    ],
    "autowiring": {
        "connections": [
            { "from": "R",   "to": "arduino:9|6|3",   "via": "openhw-resistor", "attrs": { "value": "220" } },
            { "from": "G",   "to": "arduino:10|5|11", "via": "openhw-resistor", "attrs": { "value": "220" } },
            { "from": "B",   "to": "arduino:11|3|6",  "via": "openhw-resistor", "attrs": { "value": "220" } },
            { "from": "COM", "to": "arduino:GND" }
        ]
    },
    "autocoding": {
        "arduino": {
            "setup": "#define PIN_R arduino:9|6|3\n#define PIN_G arduino:10|5|11\n#define PIN_B arduino:11|3|6\n\nvoid setup() {\n  pinMode(PIN_R, OUTPUT);\n  pinMode(PIN_G, OUTPUT);\n  pinMode(PIN_B, OUTPUT);\n}",
            "loop": "void loop() {\n  // Red\n  analogWrite(PIN_R, 255);\n  analogWrite(PIN_G, 0);\n  analogWrite(PIN_B, 0);\n  delay(500);\n\n  // Green\n  analogWrite(PIN_R, 0);\n  analogWrite(PIN_G, 255);\n  analogWrite(PIN_B, 0);\n  delay(500);\n\n  // Blue\n  analogWrite(PIN_R, 0);\n  analogWrite(PIN_G, 0);\n  analogWrite(PIN_B, 255);\n  delay(500);\n}"
        }
    }
}
