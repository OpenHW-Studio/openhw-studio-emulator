{
  "type": "openhw-mfrc522",
  "label": "MFRC522 RFID Reader",
  "group": "Sensors",
  "description": "SPI-based RFID reader operating at 13.56 MHz. Reads Mifare Classic 1K cards and key fobs.",
  "w": 165,
  "h": 135,
  "attrs": {
    "cardUID": "DE AD BE EF",
    "cardPresent": "false"
  },
  "telemetry": {
    "template": "Powered=${state.powered}, CardPresent=${state.cardPresent}, UID=${state.cardUID}",
    "criticalKeys": [
      "state.powered",
      "state.cardPresent",
      "state.cardUID"
    ]
  },
  "pins": [
    { "id": "3V3",  "x": 15, "y": 15,  "type": "power",   "description": "Power Supply (3.3V ONLY)" },
    { "id": "RST",  "x": 15, "y": 30,  "type": "digital", "description": "Reset Pin" },
    { "id": "GND",  "x": 15, "y": 45,  "type": "power",   "description": "Ground" },
    { "id": "IRQ",  "x": 15, "y": 60,  "type": "digital", "description": "Interrupt Request (optional)" },
    { "id": "MISO", "x": 15, "y": 75,  "type": "digital", "description": "SPI MISO" },
    { "id": "MOSI", "x": 15, "y": 90,  "type": "digital", "description": "SPI MOSI" },
    { "id": "SCK",  "x": 15, "y": 105, "type": "digital", "description": "SPI Clock" },
    { "id": "SDA",  "x": 15, "y": 120, "type": "digital", "description": "SPI Chip Select (SS/SDA)" }
  ],
  "autowiring": {
    "connections": [
      { "from": "3V3",  "to": "arduino:3v3", "color": "red" },
      { "from": "GND",  "to": "arduino:GND", "color": "black" },
      { "from": "RST",  "to": "arduino:9", "color": "orange" },
      { "from": "SDA",  "to": "arduino:10", "color": "yellow" },
      { "from": "MOSI", "to": "arduino:11", "color": "blue" },
      { "from": "MISO", "to": "arduino:12", "color": "green" },
      { "from": "SCK",  "to": "arduino:13", "color": "purple" }
    ]
  },
  "autocoding": {
    "libraries": ["MFRC522"],
    "arduino": {
      "globals": "#include <SPI.h>\n#include <MFRC522.h>\n\n#define RST_PIN_${COMP_SUFFIX} ${RST}\n#define SS_PIN_${COMP_SUFFIX} ${SDA}\nMFRC522 mfrc522_${COMP_SUFFIX}(SS_PIN_${COMP_SUFFIX}, RST_PIN_${COMP_SUFFIX});",
      "setup": "SPI.begin();\nmfrc522_${COMP_SUFFIX}.PCD_Init();\nSerial.println(\"MFRC522 RFID Ready\");",
      "loop": "Serial.println(\"Scanning for RFID card...\");\nif (mfrc522_${COMP_SUFFIX}.PICC_IsNewCardPresent() && mfrc522_${COMP_SUFFIX}.PICC_ReadCardSerial()) {\n  Serial.print(\"RFID UID:\");\n  for (byte i = 0; i < mfrc522_${COMP_SUFFIX}.uid.size; i++) {\n    Serial.print(mfrc522_${COMP_SUFFIX}.uid.uidByte[i] < 0x10 ? \" 0\" : \" \");\n    Serial.print(mfrc522_${COMP_SUFFIX}.uid.uidByte[i], HEX);\n  }\n  Serial.println();\n  mfrc522_${COMP_SUFFIX}.PICC_HaltA();\n}\ndelay(500);"
    }
  }
}
