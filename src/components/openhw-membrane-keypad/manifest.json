{
    "type": "openhw-membrane-keypad",
    "label": "Membrane Keypad (4x4)",
    "description": "Standard 4x4 membrane keypad matrix. Connect rows to output pins and columns to input pullup pins to scan for key presses.",
    "group": "Inputs",
    "w": 135,
    "h": 157.5,
    "pins": [
        {
            "id": "R1",
            "x": 15,
            "y": 0,
            "type": "passive",
            "description": "Row 1"
        },
        {
            "id": "R2",
            "x": 30,
            "y": 0,
            "type": "passive",
            "description": "Row 2"
        },
        {
            "id": "R3",
            "x": 45,
            "y": 0,
            "type": "passive",
            "description": "Row 3"
        },
        {
            "id": "R4",
            "x": 60,
            "y": 0,
            "type": "passive",
            "description": "Row 4"
        },
        {
            "id": "C1",
            "x": 75,
            "y": 0,
            "type": "passive",
            "description": "Column 1"
        },
        {
            "id": "C2",
            "x": 90,
            "y": 0,
            "type": "passive",
            "description": "Column 2"
        },
        {
            "id": "C3",
            "x": 105,
            "y": 0,
            "type": "passive",
            "description": "Column 3"
        },
        {
            "id": "C4",
            "x": 120,
            "y": 0,
            "type": "passive",
            "description": "Column 4"
        }
    ],
    "autowiring": {
        "connections": [
            { "from": "R1", "to": "arduino:9" },
            { "from": "R2", "to": "arduino:8" },
            { "from": "R3", "to": "arduino:7" },
            { "from": "R4", "to": "arduino:6" },
            { "from": "C1", "to": "arduino:5" },
            { "from": "C2", "to": "arduino:4" },
            { "from": "C3", "to": "arduino:3" },
            { "from": "C4", "to": "arduino:2" }
        ]
    },
    "autocoding": {
        "libraries": ["Keypad"],
        "arduino": {
            "globals": "#include <Keypad.h>\n\nconst byte ROWS = 4;\nconst byte COLS = 4;\nchar keys[ROWS][COLS] = {\n  {'1','2','3','A'},\n  {'4','5','6','B'},\n  {'7','8','9','C'},\n  {'*','0','#','D'}\n};\nbyte rowPins[ROWS] = {9, 8, 7, 6};\nbyte colPins[COLS] = {5, 4, 3, 2};\n\nKeypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);",
            "setup": "Serial.begin(9600);",
            "loop": "char key = keypad.getKey();\nif (key) {\n  Serial.print(\"Key Pressed: \");\n  Serial.println(key);\n}"
        }
    }
}
